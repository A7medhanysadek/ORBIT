<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Orbit Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
            line-height: 1.7;
            color: #e2e8f0;
            background: #0a0e1a;
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .email-wrapper {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
        }

        .activation-container {
            background: linear-gradient(160deg, #0d1424 0%, #0a0e1a 50%, #0d1a2a 100%);
            border-radius: 24px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(0, 212, 255, 0.15);
            box-shadow:
                0 0 0 1px rgba(0, 212, 255, 0.08),
                0 32px 64px rgba(0, 0, 0, 0.6),
                0 0 80px rgba(0, 212, 255, 0.06);
        }

        .glow-bar {
            height: 3px;
            background: linear-gradient(90deg, transparent, #00d4ff, #06b6d4, #00d4ff, transparent);
        }

        .activation-header {
            padding: 40px 30px 28px;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .logo-wrap {
            display: block;
            width: 88px;
            height: 88px;
            background: radial-gradient(circle at center, rgba(0, 212, 255, 0.15) 0%, rgba(0, 212, 255, 0.03) 70%);
            border-radius: 24px;
            border: 1px solid rgba(0, 212, 255, 0.25);
            margin: 0 auto 18px;
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            text-align: center;
            line-height: 88px;
        }

        .logo-img {
            width: 56px;
            height: 56px;
            object-fit: contain;
        }

        .app-name {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            margin: 0 0 6px;
            letter-spacing: 1px;
        }

        .app-tagline {
            font-size: 13px;
            color: rgba(0, 212, 255, 0.7);
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.2), transparent);
            margin: 0 30px;
        }

        .activation-body {
            padding: 32px 30px 28px;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .user-greeting {
            font-size: 20px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 14px;
        }

        .user-greeting span {
            color: #00d4ff;
        }

        .welcome-message {
            color: rgba(226, 232, 240, 0.65);
            margin-bottom: 28px;
            font-size: 15px;
            line-height: 1.8;
        }

        .activation-code-container {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.07) 0%, rgba(6, 182, 212, 0.04) 100%);
            border: 1px solid rgba(0, 212, 255, 0.3);
            border-radius: 18px;
            padding: 28px 24px;
            margin: 0 0 22px;
            position: relative;
            overflow: hidden;
        }

        .code-label {
            font-size: 12px;
            color: rgba(0, 212, 255, 0.6);
            margin-bottom: 12px;
            font-weight: 600;
            letter-spacing: 2.5px;
            text-transform: uppercase;
        }

        .activation-code {
            color: #00d4ff;
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 10px;
            font-family: 'Courier New', monospace;
            position: relative;
            z-index: 1;
            text-shadow:
                0 0 20px rgba(0, 212, 255, 0.6),
                0 0 40px rgba(0, 212, 255, 0.3);
        }

        .expiry-info {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(251, 191, 36, 0.08);
            border: 1px solid rgba(251, 191, 36, 0.25);
            border-radius: 50px;
            padding: 10px 20px;
            color: #fbbf24;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 28px;
        }

        .features-preview {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 14px;
            padding: 20px 22px;
            margin-bottom: 20px;
            text-align: left;
        }

        .features-title {
            font-size: 13px;
            font-weight: 700;
            color: rgba(226, 232, 240, 0.5);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .features-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .features-list li {
            padding: 7px 0;
            color: rgba(226, 232, 240, 0.7);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .features-list li:last-child {
            border-bottom: none;
        }

        .ignore-note {
            color: rgba(226, 232, 240, 0.35);
            font-size: 13px;
            margin-top: 8px;
        }

        .activation-footer {
            background: rgba(0, 0, 0, 0.25);
            border-top: 1px solid rgba(0, 212, 255, 0.08);
            padding: 22px 30px;
            text-align: center;
        }

        .footer-info {
            font-size: 12px;
            color: rgba(226, 232, 240, 0.35);
            margin-bottom: 6px;
        }

        .support-link {
            color: rgba(0, 212, 255, 0.7);
            text-decoration: none;
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 212, 255, 0.06);
            border: 1px solid rgba(0, 212, 255, 0.15);
            color: rgba(0, 212, 255, 0.6);
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 500;
            margin-top: 10px;
            letter-spacing: 0.5px;
        }

        @media (max-width: 580px) {
            .activation-header { padding: 32px 20px 22px; }
            .activation-body   { padding: 26px 20px 22px; }
            .activation-footer { padding: 18px 20px; }
            .activation-code { font-size: 28px; letter-spacing: 6px; }
            .logo-wrap { width: 72px; height: 72px; border-radius: 18px; }
            .logo-img  { width: 44px; height: 44px; }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="activation-container">

            <div class="glow-bar"></div>

            <!-- Header -->
            <div class="activation-header">
                <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 auto 18px;">
                    <tr>
                        <td align="center" valign="middle" style="width:88px;height:88px;background:radial-gradient(circle at center, rgba(0,212,255,0.15) 0%, rgba(0,212,255,0.03) 70%);border-radius:24px;border:1px solid rgba(0,212,255,0.25);box-shadow:0 0 30px rgba(0,212,255,0.15);text-align:center;">
                            <img class="logo-img" src="{3}" alt="Orbit Logo" style="width:56px;height:56px;display:block;margin:0 auto;">
                        </td>
                    </tr>
                </table>
                <h1 class="app-name">Orbit</h1>
                <p class="app-tagline">Stream Across the Galaxy</p>
            </div>

            <div class="divider"></div>

            <!-- Body -->
            <div class="activation-body">
                <p class="user-greeting">Hey, <span>{0}</span> &#128075;</p>

                <p class="welcome-message">
                    We received a request to reset your password for your <strong style="color:#00d4ff;">Orbit</strong> account.
                    To set a new password, please use the reset code below:
                </p>

                <!-- OTP Code -->
                <div class="activation-code-container">
                    <div class="code-label">Reset Code</div>
                    <div class="activation-code">{1}</div>
                </div>

                <!-- Expiry -->
                <div class="expiry-info">
                    &#9201; This code is valid for 30 minutes only
                </div>

                <p class="ignore-note">
                    If you didn't request a password reset, please ignore this email.
                </p>
            </div>

            <!-- Footer -->
            <div class="activation-footer">
                <div class="footer-info">
                    &copy; {2} Orbit &mdash; Stream Across the Galaxy
                </div>
                <div class="footer-info">
                    Have a question?
                    <a href="mailto:support@orbit.app" class="support-link">support@orbit.app</a>
                </div>
                <div class="security-badge">&#128274; Protected with military-grade encryption</div>
            </div>

        </div>
    </div>
</body>
</html>

